## Modèle de configuration pour la PRODUCTION.
## Copier vers `.env` sur le serveur, compléter les valeurs vides, puis exécuter :
##   composer install --no-dev --optimize-autoloader
##   php artisan key:generate
##   php artisan migrate --force
##   php artisan storage:link
##   php artisan config:cache && php artisan route:cache && php artisan view:cache
## Avec Docker : l'image lance migrate + les caches au démarrage (RUN_MIGRATIONS=false pour désactiver) ;
## le hoster fournit PORT. Monter un volume sur storage/app/public (photos/vidéos téléversées).
## Les valeurs contenant #, $ ou des espaces doivent être entre guillemets.

APP_NAME="PPN d'Andé"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ppn-ande.example.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=error

# Compte MySQL dédié, PAS root
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppn_ande
DB_USERNAME=
DB_PASSWORD=

# SESSION_SECURE_COOKIE=true exige HTTPS, sinon la connexion ne fonctionne pas
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# "database" demande un worker (php artisan queue:work) ; mettre "sync" sans worker
QUEUE_CONNECTION=database

# Avec MAIL_MAILER=log, aucun e-mail ne part (mot de passe oublié, alertes « à valider », formulaire de contact)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Port 465 : décommenter MAIL_SCHEME=smtps (MAIL_ENCRYPTION n'est plus lu par Laravel 12)
# MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@ppn-ande.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Uniquement pour `php artisan db:seed` (sinon mots de passe aléatoires affichés une fois) ; à retirer ensuite
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
