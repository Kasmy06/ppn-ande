## Modèle de configuration pour un déploiement en PRODUCTION.
## Copier ce fichier vers `.env` sur le serveur de production et compléter les valeurs,
## puis exécuter : php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME="PPN d'Andé"
APP_ENV=production
APP_KEY=                       # générer avec: php artisan key:generate
APP_DEBUG=false                # IMPORTANT : ne jamais laisser à true en production
APP_URL=https://ppn-ande.example.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppn_ande
DB_USERNAME=                   # compte MySQL dédié, PAS root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # nécessite HTTPS

CACHE_STORE=database
QUEUE_CONNECTION=database

# Configurer un vrai fournisseur SMTP pour que les emails (mot de passe oublié) partent réellement.
# Avec MAIL_MAILER=log (valeur de développement), les emails ne sont jamais envoyés : ils sont
# seulement écrits dans storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@ppn-ande.fr"
MAIL_FROM_NAME="${APP_NAME}"
